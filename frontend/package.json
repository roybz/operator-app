{
  "name": "operator-app",
  "version": "0.0.3",
  "guestModeOnly": false,
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.storybook.config.ts",
    "test:security": "npm audit --audit-level=moderate",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "audit:conventions": "node scripts/conventions-audit.mjs",
    "test:smoke": "npm run test:unit && npm run test:e2e",
    "test:regression": "npm run test:smoke",
    "test:release-gates": "npm run lint && npm run test:unit -- --watch=false && npm run build && npm run build-storybook",
    "serve:ssr:operator-app": "node dist/operator-app/server/server.mjs",
    "lint": "ng lint",
    "storybook": "ng run operator-app:storybook",
    "build-storybook": "ng run operator-app:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/addon-docs": "^10.2.15",
    "@storybook/angular": "^10.2.15",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.2.15",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.2.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.8"
  }
}
